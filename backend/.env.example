
# SaluteSpeech (автотранскрипция звонков). Пусто = сервис транскрипции выключен.
# SALUTE_AUTH_KEY — Authorization key из кабинета developers.sber.ru (base64 ClientID:Secret)
# SALUTE_SCOPE — SALUTE_SPEECH_PERS (физлицо) | SALUTE_SPEECH_B2B (юрлицо, предоплата)
SALUTE_AUTH_KEY=
SALUTE_SCOPE=SALUTE_SPEECH_PERS

# Шифрование секретов CRM-подключений (AES-256-GCM), любая строка от 16 символов
CRM_ENCRYPTION_KEY=
SUPERADMIN_TG_CHAT_ID=
