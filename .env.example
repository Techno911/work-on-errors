# ─── Database ────────────────────────────────────────────────────────────────
DB_HOST=postgres
DB_PORT=5432
DB_USERNAME=ro_user
DB_PASSWORD=
DB_NAME=ro_db

# ─── JWT ─────────────────────────────────────────────────────────────────────
JWT_SECRET=
JWT_REFRESH_SECRET=
JWT_ACCESS_EXPIRATION=15m
JWT_REFRESH_EXPIRATION=7d

# ─── App ─────────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000
FRONTEND_URL=http://localhost:15173
APP_URL=http://localhost:15173

# ─── File uploads ────────────────────────────────────────────────────────────
MAX_FILE_SIZE=10485760
UPLOAD_DEST=./uploads

# ─── Frontend (build-time) ───────────────────────────────────────────────────
# Set to your public domain in production (e.g. https://app.example.invalid/api)
# Leave as /api when using nginx reverse-proxy (default docker-compose setup)
VITE_API_URL=/api

# Адрес платформы, подставляется в письма и уведомления
MAIL_FROM=noreply@example.invalid

# Реквизиты своей стороны договора (чёрный список парсера, регулярки JS)
EXECUTOR_INNS=
EXECUTOR_NAME_PATTERN=
EXECUTOR_ADDRESS_PATTERN=

# Пароли сидов (пусто = случайная генерация при каждом сиде)
SEED_ADMIN_PASSWORD=
SEED_DEMO_PASSWORD=

# STT GigaAM (self-hosted, адрес своего сервиса распознавания)
STT_BASE_URL=

# SaluteSpeech (платный API, пусто = выключен)
SALUTE_AUTH_KEY=
SALUTE_SCOPE=SALUTE_SPEECH_PERS

# Шифрование секретов CRM-подключений (AES-256-GCM, любая строка от 16 символов)
CRM_ENCRYPTION_KEY=

# Ollama (опционально, локальный инстанс)
OLLAMA_BASE_URL=
OLLAMA_GENERATE_MODEL=
OLLAMA_EMBED_MODEL=

# Telegram-уведомления (пусто = выключены)
TELEGRAM_BOT_TOKEN=
SUPERADMIN_TG_CHAT_ID=

# SMTP (пусто = localhost:25)
SMTP_HOST=
SMTP_PORT=25
SMTP_USER=
SMTP_PASS=
